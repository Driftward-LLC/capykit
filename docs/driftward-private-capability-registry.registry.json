{
  "schemaVersion": "0.1.0",
  "registry": {
    "id": "driftward-private-capabilities",
    "name": "Driftward private capability registry",
    "description": "Private operator-approved source for Driftward and Derek-specific capability records. This file is intended to live outside the public Capykit application repository when activated.",
    "homepage": "https://github.com/Driftward-LLC/capykit/blob/main/docs/driftward-private-capability-registry.md"
  },
  "tools": [
    {
      "id": "agent-browser",
      "name": "agent-browser",
      "summary": "Hermes/browser automation capability for sites without a reliable API.",
      "owners": [
        {
          "id": "driftward-ops",
          "name": "Driftward operations",
          "url": "https://github.com/Driftward-LLC"
        }
      ],
      "interfaces": [
        {
          "id": "agent-browser-cli",
          "type": "cli",
          "command": "hermes",
          "capabilities": [
            {
              "name": "operate-browser",
              "summary": "Navigate approved sites through browser automation with screenshots and accessibility snapshots."
            }
          ]
        }
      ],
      "scope": {
        "visibility": "host",
        "audiences": [
          "human",
          "agent"
        ],
        "platforms": [
          "linux",
          "web"
        ],
        "contexts": [
          "driftward-vps"
        ]
      },
      "authentication": {
        "mode": "required",
        "requirements": [
          {
            "id": "browser-session-provider",
            "type": "session",
            "description": "Browser session storage and any login material are managed by the approved agent runtime.",
            "references": [
              {
                "kind": "provider",
                "name": "driftward-hermes-runtime"
              }
            ]
          }
        ]
      },
      "safety": {
        "risk": "writes-data",
        "approval": "always"
      },
      "lifecycle": {
        "status": "active"
      },
      "healthChecks": [
        {
          "id": "agent-browser-runtime",
          "kind": "command-available",
          "command": "hermes"
        }
      ],
      "documentation": [
        {
          "label": "Hermes browser tool documentation",
          "url": "https://hermes-agent.nousresearch.com/docs"
        }
      ],
      "relationships": [],
      "examples": [
        {
          "title": "Use browser automation after selecting an approved task target",
          "interfaceId": "agent-browser-cli",
          "usage": "hermes --help"
        }
      ]
    },
    {
      "id": "browserbase-browse",
      "name": "Browserbase browse",
      "summary": "Managed Browserbase browsing sessions for web tasks that need a remote browser.",
      "owners": [
        {
          "id": "driftward-ops",
          "name": "Driftward operations",
          "url": "https://github.com/Driftward-LLC"
        }
      ],
      "interfaces": [
        {
          "id": "browserbase-api",
          "type": "api",
          "protocol": "https",
          "baseUrl": "https://api.browserbase.com",
          "operations": [
            {
              "id": "create-session",
              "method": "POST",
              "path": "/v1/sessions",
              "summary": "Create an approved hosted browser session."
            },
            {
              "id": "get-session",
              "method": "GET",
              "path": "/v1/sessions/{id}",
              "summary": "Read hosted browser session state."
            }
          ]
        }
      ],
      "scope": {
        "visibility": "organization",
        "audiences": [
          "agent"
        ],
        "platforms": [
          "web"
        ],
        "contexts": [
          "driftward"
        ]
      },
      "authentication": {
        "mode": "required",
        "requirements": [
          {
            "id": "browserbase-project",
            "type": "api-key",
            "description": "Browserbase project selection is supplied by environment reference.",
            "references": [
              {
                "kind": "environment",
                "name": "BROWSERBASE_PROJECT_ID"
              }
            ]
          },
          {
            "id": "browserbase-api",
            "type": "api-key",
            "description": "Browserbase API access is supplied by environment reference.",
            "references": [
              {
                "kind": "environment",
                "name": "BROWSERBASE_API_KEY"
              }
            ]
          }
        ]
      },
      "safety": {
        "risk": "executes-code",
        "approval": "always",
        "notes": "Hosted browsing can interact with third-party sites and must follow task-specific authorization."
      },
      "lifecycle": {
        "status": "active"
      },
      "healthChecks": [
        {
          "id": "browserbase-api-status",
          "kind": "http-get",
          "url": "https://api.browserbase.com/",
          "expectedStatus": 200
        }
      ],
      "documentation": [
        {
          "label": "Browserbase documentation",
          "url": "https://docs.browserbase.com/"
        }
      ],
      "relationships": [],
      "examples": [
        {
          "title": "Create hosted browser session",
          "interfaceId": "browserbase-api",
          "usage": "POST /v1/sessions with credentials resolved from the approved environment."
        }
      ]
    },
    {
