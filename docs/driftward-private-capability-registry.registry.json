      ],
      "interfaces": [
        {
          "id": "notion-api",
          "type": "api",
          "protocol": "https",
          "baseUrl": "https://api.notion.com",
          "operations": [
            {
              "id": "query-database",
              "method": "POST",
              "path": "/v1/databases/{database_id}/query",
              "summary": "Query an approved Notion database."
            },
            {
              "id": "create-page",
              "method": "POST",
              "path": "/v1/pages",
              "summary": "Create a page in an approved Notion parent."
            },
            {
              "id": "update-page",
              "method": "PATCH",
              "path": "/v1/pages/{page_id}",
              "summary": "Update properties on an approved Notion page."
            }
          ]
        }
      ],
      "scope": {
        "visibility": "organization",
        "audiences": [
          "human",
          "agent"
        ],
        "platforms": [
          "web"
        ],
        "contexts": [
          "driftward"
        ]
      },
      "authentication": {
        "mode": "required",
        "requirements": [
          {
            "id": "notion-api-access",
            "type": "api-key",
            "description": "Notion API access is supplied by environment reference or an approved secrets provider.",
            "references": [
              {
                "kind": "environment",
                "name": "NOTION_TOKEN"
              }
            ]
          }
        ]
      },
      "safety": {
        "risk": "writes-data",
        "approval": "on-write"
      },
      "lifecycle": {
        "status": "active"
      },
      "healthChecks": [
        {
          "id": "notion-users-me",
          "kind": "http-get",
          "url": "https://api.notion.com/v1/users/me",
          "expectedStatus": 401
        }
      ],
      "documentation": [
        {
          "label": "Notion API reference",
          "url": "https://developers.notion.com/reference/intro"
        }
      ],
      "relationships": [],
      "examples": [
        {
          "title": "Query an approved database",
          "interfaceId": "notion-api",
          "usage": "POST /v1/databases/{database_id}/query with access resolved from NOTION_TOKEN."
