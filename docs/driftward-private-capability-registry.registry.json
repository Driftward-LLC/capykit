    {
      "id": "notion-api",
      "name": "Notion API",
      "summary": "Notion API access for Driftward workspaces and acquisition operating data.",
      "owners": [
        {
          "id": "driftward-ops",
          "name": "Driftward operations",
          "url": "https://github.com/Driftward-LLC"
