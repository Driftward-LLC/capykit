{
  "name": "@driftward/capykit",
  "version": "0.1.1",
  "description": "Portable capability registry for people and agents",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Driftward-LLC/capykit.git" },
  "bugs": { "url": "https://github.com/Driftward-LLC/capykit/issues" },
  "homepage": "https://github.com/Driftward-LLC/capykit#readme",
  "keywords": ["agent-tools", "capability-registry", "mcp", "cli", "registry"],
  "publishConfig": { "access": "public", "provenance": true },
  "engines": { "node": ">=22" },
  "bin": { "capykit": "dist/cli.js", "capykit-mcp": "dist/mcp.js", "capykit-hosted-api": "dist/hosted-api.js", "capykit-hosted-worker": "dist/hosted-worker.js" },
  "exports": { ".": "./dist/core.js", "./core": "./dist/core.js", "./schemas": "./dist/schemas.js", "./mcp": "./dist/mcp.js", "./hosted": "./dist/hosted-api.js" },
  "files": ["dist", "schemas", "scripts/migrations", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup && node scripts/build-hosted.mjs && vite build src/console --outDir ../../dist/console --emptyOutDir false", "build:standalone": "node scripts/build-standalone.mjs", "lint": "eslint .", "typecheck": "tsc --noEmit", "test": "vitest run", "test:package": "node scripts/test-package.mjs",
    "check:schema": "node scripts/test-schema.mjs && node scripts/test-security-policy.mjs",
    "container:print-dockerfile": "node scripts/container-image.mjs print-containerfile",
    "container:metadata": "node scripts/container-image.mjs print-metadata",
    "check:secrets": "node scripts/check-public-repository.mjs",
    "factory:verify": "node scripts/factory-verification.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package && npm run check:schema && npm run check:secrets",
    "start:hosted-api": "node dist/hosted-api.js", "start:hosted-worker": "node dist/hosted-worker.js"
  },
  "dependencies": { "@fastify/cookie": "^11.1.2", "@modelcontextprotocol/sdk": "^1.17.4", "@supabase/supabase-js": "^2.116.0", "ajv": "^8.17.1", "fastify": "^5.12.5", "pg": "^8.23.0", "react": "^19.3.0", "react-dom": "^19.3.0", "vite": "^7.3.6", "zod": "^4.4.3" },
  "devDependencies": { "@eslint/js": "^9.33.0", "@types/node": "^22.17.2", "@types/pg": "^8.23.1", "@types/react": "^19.3.0", "@types/react-dom": "^19.3.0", "eslint": "^9.33.0", "tsup": "^8.5.0", "typescript": "^5.9.2", "typescript-eslint": "^8.40.0", "vitest": "^3.2.4" }
}
