FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsup.config.ts ./
COPY src ./src
COPY scripts/build-hosted.mjs ./scripts/build-hosted.mjs
COPY schemas ./schemas
RUN npm run build

FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY scripts/bootstrap-hosted-owner.mjs ./scripts/bootstrap-hosted-owner.mjs
COPY scripts/provision-hosted-owner.mjs ./scripts/provision-hosted-owner.mjs
COPY scripts/cleanup-hosted-connections.mjs ./scripts/cleanup-hosted-connections.mjs
COPY scripts/migrations ./scripts/migrations
USER node
EXPOSE 3000 3001
CMD ["node", "dist/hosted-api.js"]
